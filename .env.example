# Copy to .env and fill in. Every setting is prefixed BT_ (BusTrust).

# Where parsed tables live. SQLite for local dev; Postgres + TimescaleDB in production.
BT_DATABASE_URL=sqlite:///data/bustrust.db
# BT_DATABASE_URL=postgresql+psycopg://bustrust:bustrust@db:5432/bustrust

# "nta" polls the real feeds (needs a key); "simulated" builds realistic feeds from the static schedule.
BT_FEED_MODE=simulated

# NTA developer portal keys, comma separated. Only the first is used until the NTA
# agrees to both running at once (see docs/runbook.md).
BT_NTA_API_KEYS=
BT_USE_BOTH_KEYS=false

# Raw response archive: a local folder or s3://bucket/prefix
BT_RAW_ARCHIVE=data/raw

# Healthchecks.io ping URL; pinged after every successful poll.
BT_HEARTBEAT_URL=

# Sentry DSN for the API (optional)
BT_SENTRY_DSN=

# Docker stack only (infra/docker-compose.yml). The compose file builds BT_DATABASE_URL
# from this password, overriding the SQLite URL above.
POSTGRES_PASSWORD=
# Public hostname; Caddy gets the TLS certificate for it. Leave as localhost to try it locally.
BT_DOMAIN=localhost
